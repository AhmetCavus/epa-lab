{
  "name": "epa-auth-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "env:init": "node infrastructure/setup-env.mjs",
    "playground:up": "docker compose -f infrastructure/docker-compose.playground.yml up -d --build --wait --wait-timeout 180",
    "playground:down": "docker compose -f infrastructure/docker-compose.playground.yml down",
    "playground:logs": "docker compose -f infrastructure/docker-compose.playground.yml logs --follow playground",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker-compose.yml up -d --wait --wait-timeout 180",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker-compose.yml down",
    "infra:reset": "docker compose --env-file .env -f infrastructure/docker-compose.yml down --volumes",
    "docker:up": "docker compose --env-file .env -f infrastructure/docker-compose.yml --profile backend up -d --build --wait --wait-timeout 180",
    "docker:down": "docker compose --env-file .env -f infrastructure/docker-compose.yml --profile backend down",
    "docker:logs": "docker compose --env-file .env -f infrastructure/docker-compose.yml --profile backend logs --follow epa-authorization",
    "dev": "pnpm --filter @epa-auth-lab/authorization dev",
    "start": "pnpm --filter @epa-auth-lab/authorization start",
    "build": "pnpm --filter @epa-auth-lab/authorization build",
    "typecheck": "pnpm --filter @epa-auth-lab/authorization typecheck",
    "test": "pnpm --filter @epa-auth-lab/authorization test",
    "test:integration": "pnpm --filter @epa-auth-lab/authorization test:integration",
    "lint": "eslint services/epa-authorization --max-warnings 0 && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript-eslint": "8.71.1"
  }
}
