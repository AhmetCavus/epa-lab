vars {
  MODE: stag
  @description('Base URL of the NestJS authorization server; no trailing slash.')
  EPA_AUTHORIZATION_BASE_URL: https://epa-auth.stag.example.invalid
  @description('Exact issuer advertised by discovery and configured in the authorization server.')
  OIDC_ISSUER: https://idp.stag.example.invalid/realms/epa-demo
  @description('Confidential client registered at the IDP.')
  OIDC_CLIENT_ID: epa-auth-server
  @description('Exact URI registered at the IDP and allowed by the authorization server.')
  OIDC_DEFAULT_REDIRECT_URI: https://fdv.stag.example.invalid/callback
  @description('OIDC scopes pushed to the IDP; Milestone 1 uses openid.')
  OIDC_SCOPE: openid
  @description('Required FdV identifier: product/version, matching the backend header schema.')
  X_USERAGENT: EPA-AUTH-LAB/0.1.0
}
vars:secret [
  @description('Set locally only; needed for direct IDP PAR, never for requests to NestJS.')
  OIDC_CLIENT_SECRET
]
