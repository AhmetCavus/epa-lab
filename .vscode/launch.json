{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug auth-client",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/services/auth-client/dist/main.js",
      "cwd": "${workspaceFolder}/services/auth-client",
      "preLaunchTask": "auth-client: build",
      "runtimeArgs": ["--enable-source-maps"],
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/services/auth-client/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
