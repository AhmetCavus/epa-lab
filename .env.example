# Nur isolierte lokale Entwicklung. pnpm env:init erzeugt zufällige Zugangsdaten.
KEYCLOAK_ADMIN_USERNAME=epa-lab-admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_PORT=8080
KEYCLOAK_HOSTNAME=http://localhost:8080
OIDC_CLIENT_SECRET=
TEST_USER_PASSWORD=
RES_SERVER_DB_PASSWORD=
RES_SERVER_BIND_ADDRESS=127.0.0.1
RES_SERVER_PORT=8083
# Obtain jwks_uri from the trusted issuer's discovery document; required by the new HAPI image.
RES_SERVER_JWKS_URI=http://localhost:8080/realms/epa-demo/protocol/openid-connect/certs
# Compose maps these names to the auth client's HOST/PORT without inheriting Yoster's port.
AUTH_CLIENT_HOST=127.0.0.1
AUTH_CLIENT_PORT=3000
# HOST/PORT are used when running the auth client directly outside Docker.
PORT=3000
HOST=127.0.0.1
# Für LAN-Zugriff AUTH_CLIENT_HOST, KEYCLOAK_BIND_ADDRESS und RES_SERVER_BIND_ADDRESS
# auf die LAN-Adresse setzen; KEYCLOAK_HOSTNAME, OIDC_ISSUER und Redirect-URIs anpassen.
OIDC_ALLOW_PRIVATE_NETWORK_HTTP=false
OIDC_ISSUER=http://localhost:8080/realms/epa-demo
OIDC_CLIENT_ID=epa-auth-server
OIDC_DEFAULT_REDIRECT_URI=http://localhost:3000/callback
OIDC_ALLOWED_REDIRECT_URIS=["http://localhost:3000/callback"]
OIDC_HTTP_TIMEOUT_MS=5000
OIDC_DISCOVERY_CACHE_TTL_MS=300000
# Standard backend routes are opt-in; the public Playground remains fixture-only.
PLAYGROUND_OIDC_ENABLED=false
PLAYGROUND_APP_ORIGIN=http://localhost:3000
PLAYGROUND_OIDC_CLIENT_ID=playground-oidc
PLAYGROUND_OIDC_CLIENT_SECRET=
PLAYGROUND_OIDC_REDIRECT_URI=http://localhost:3000/api/oauth/callback
PLAYGROUND_FHIR_RESOURCE_URL=http://127.0.0.1:18083/fhir/Basic/playground-demo
