# Nur isolierte lokale Entwicklung. pnpm env:init erzeugt zufällige Zugangsdaten.
KEYCLOAK_ADMIN_USERNAME=epa-lab-admin
KEYCLOAK_ADMIN_PASSWORD=
OIDC_CLIENT_SECRET=
TEST_USER_PASSWORD=
PORT=3000
OIDC_ISSUER=http://localhost:8080/realms/epa-demo
OIDC_CLIENT_ID=epa-auth-server
OIDC_DEFAULT_REDIRECT_URI=http://localhost:3000/callback
OIDC_ALLOWED_REDIRECT_URIS=["http://localhost:3000/callback"]
OIDC_HTTP_TIMEOUT_MS=5000
OIDC_DISCOVERY_CACHE_TTL_MS=300000
