{
  "id": "epa-lab",
  "name": "Auth Protocol Playground",
  "slug": "epa-lab",
  "type": "app",
  "category": "hosted-app",
  "composeFile": "infrastructure/docker-compose.host.yml",
  "composeEnvFile": ".env",
  "publicUrl": "https://auth-playground.yappai.de",
  "description": "Authentication lab with Keycloak, an OAuth client, a FHIR resource server and a fixture-only playground.",
  "services": [
    {
      "name": "keycloak",
      "containerName": "epa-lab-keycloak"
    },
    {
      "name": "auth-client",
      "containerName": "epa-lab-auth-client"
    },
    {
      "name": "res-server",
      "containerName": "epa-lab-res-server"
    },
    {
      "name": "res-server-db",
      "containerName": "epa-lab-res-server-db"
    },
    {
      "name": "playground",
      "containerName": "epa-lab-playground",
      "healthUrl": "http://epa-lab-playground/health"
    }
  ],
  "healthChecks": [
    {
      "label": "Keycloak readiness",
      "type": "container",
      "containerName": "epa-lab-keycloak"
    },
    {
      "label": "Auth client and OIDC discovery",
      "type": "container",
      "containerName": "epa-lab-auth-client"
    },
    {
      "label": "FHIR resource server",
      "type": "container",
      "containerName": "epa-lab-res-server"
    },
    {
      "label": "FHIR PostgreSQL",
      "type": "container",
      "containerName": "epa-lab-res-server-db"
    },
    {
      "label": "Playground HTTP",
      "type": "http",
      "url": "http://epa-lab-playground/health",
      "expectedStatus": 200,
      "timeoutMs": 3000
    },
    {
      "label": "Playground container",
      "type": "container",
      "containerName": "epa-lab-playground"
    }
  ],
  "actions": {
    "start": true,
    "stop": true,
    "restart": true,
    "logs": true,
    "delete": false
  },
  "tags": ["playground", "keycloak", "oidc", "fhir", "postgresql", "traefik"]
}
